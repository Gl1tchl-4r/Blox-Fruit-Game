    local rightArrowTextStroke = Instance.new("UIStroke")
    rightArrowTextStroke.Color = Color3.fromRGB(0, 0, 0)
    rightArrowTextStroke.Thickness = 1.5
    rightArrowTextStroke.Parent = rightArrowLabel

    -- Hover effect สำหรับปุ่ม Arrow
    local function setupArrowHover(btn, stroke)
        btn.MouseEnter:Connect(function()
            stroke.Color = Color3.fromRGB(255, 255, 130)
            btn.BackgroundColor3 = Color3.fromRGB(35, 36, 45)
        end)
        btn.MouseLeave:Connect(function()
            stroke.Color = Color3.fromRGB(255, 199, 29)
            btn.BackgroundColor3 = THEME.ContentBg
        end)
    end
    setupArrowHover(leftArrowBtn, leftArrowStroke)
    setupArrowHover(rightArrowBtn, rightArrowStroke)

    leftArrowBtn.Activated:Connect(function()
        self:PrevPage()
    end)

    rightArrowBtn.Activated:Connect(function()
        self:NextPage()
    end)

    -- แนบ ScreenGui เข้าสู่เป้าหมาย
    screenGui.Parent = parentTarget

    -- บันทึก References
    self.ScreenGui = screenGui
    self.MainFrame = mainFrame
    self.ToggleButton = toggleBtn
    self.Menu = menu
    self.TitleFrame = titleFrame
    self.TitleMain = titleMain
    self.TitleShadow = titleShadow
    self.ContentFrame = content
    self.PagesContainer = pagesContainer
    self.FooterFrame = footer
    self.UserLabel = userLabel
    self.RaceLabel = raceLabel
    self.StatusLabel = statusTextLabel
    self.FragLabel = fragLabel

    self.MirrorItem = mirrorItem
    self.ValkItem = valkItem
    self.LeverItem = leverItem

    self.LeftArrowBtn = leftArrowBtn
    self.RightArrowBtn = rightArrowBtn
    self.JobIdInput = jobIdInput
    self.HopStatusLabel = hopStatusLabel
    self.HopCallbacks = {}

    -- ระบบจัดการหน้า
    self.Pages = {
        {
            Name = "Dashboard",
            Title = "Dashboard",
            Frame = pageDashboard
        },
        {
            Name = "ServerManager",
            Title = "Server Manager",
            Frame = pageServer
        }
    }
    self.CurrentPageIndex = 1

    -- Backwards Compatibility References
    self.MirrorLabel = mirrorItem.Card
    self.ValkLabel = valkItem.Card
    self.LeverLabel = leverItem.Card

    self.IsVisible = true

    -- คีย์ลัด Toggle UI ด้วยปุ่ม M
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == Enum.KeyCode.M then
            self:Toggle()
        end
    end)

    return self
end

-- อัปเดตสถานะ Status (Melee/Defense Card position)
function UIManager:UpdateStatus(statusText)
    if self.StatusLabel and self.StatusLabel.Parent then
        self.StatusLabel.Text = "Status: " .. tostring(statusText or "Idle")
    end
end

-- อัปเดตข้อมูลผู้เล่นและเผ่า: Username (ฝั่งซ้าย) และ Race (ฝั่งขวา) ให้สมมาตร
function UIManager:UpdatePlayerInfo(playerName, raceName, raceVer, raceTier)
    local user = tostring(playerName or LocalPlayer.Name)
    local race = tostring(raceName or "Human")
    local ver = tostring(raceVer or "1")
    local tier = tostring(raceTier or "0")

    if self.UserLabel and self.UserLabel.Parent then
        self.UserLabel.Text = string.format("Username: %s", user)
    end
    if self.RaceLabel and self.RaceLabel.Parent then
        self.RaceLabel.Text = string.format("Race: %s V%s [%s]", race, ver, tier)
    end
end

-- อัปเดต Fragments ใน Footer ตรง "Stat Points: 63" ด้วยสีม่วงและตัว ƒ
function UIManager:UpdateFragments(fragCount)
    if self.FragLabel and self.FragLabel.Parent then
        local formattedFrags = tostring(fragCount or 0)
        formattedFrags = formattedFrags:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
        self.FragLabel.Text = "ƒ " .. formattedFrags
    end
end

-- อัปเดตสถานะไอเทม (Mirror, Valk, Lever)
function UIManager:UpdateItems(data, valkArg, leverArg)
    local mirrorState, valkState, leverState
    if type(data) == "table" then
        mirrorState = data.Mirror
        valkState = data.Valk
        leverState = data.Lever
    else
        mirrorState = data
        valkState = valkArg
        leverState = leverArg
    end

    local function applyVisualState(itemWidget, isCompleted)
        if not itemWidget or isCompleted == nil then return end

        local targetBorderColor = isCompleted and THEME.Success or THEME.Fail
        local targetBgColor     = isCompleted and THEME.BgSuccess or THEME.BgFail
        local targetAlpha       = isCompleted and 0 or 0.45
        local targetLabelColor  = isCompleted and THEME.Success or Color3.fromRGB(220, 220, 220)

        if itemWidget.Stroke then
            itemWidget.Stroke.Color = targetBorderColor
        end
        if itemWidget.Card then
            itemWidget.Card.BackgroundColor3 = targetBgColor
        end
        if itemWidget.Icon then
            itemWidget.Icon.ImageTransparency = targetAlpha
        end
        if itemWidget.Label then
            itemWidget.Label.TextColor3 = targetLabelColor
        end
    end

    if mirrorState ~= nil then
        applyVisualState(self.MirrorItem, mirrorState)
    end
    if valkState ~= nil then
        applyVisualState(self.ValkItem, valkState)
    end
    if leverState ~= nil then
        applyVisualState(self.LeverItem, leverState)
    end
end

function UIManager:SetVisible(visible)
    self.IsVisible = visible
    if self.MainFrame then
        self.MainFrame.Visible = visible
    end
end

function UIManager:Toggle()
    self:SetVisible(not self.IsVisible)
end

function UIManager:Destroy()
    if self.ScreenGui then
        self.ScreenGui:Destroy()
        self.ScreenGui = nil
    end
end

-- ==============================================================================
-- ระบบจัดการหน้า (Multi-Page Navigation Methods)
-- ==============================================================================

-- เปลี่ยนไปยังหน้าที่ระบุ (index หรือ ชื่อหน้า)
function UIManager:SetPage(target)
    local targetIndex = nil
    if type(target) == "number" then
        if target >= 1 and target <= #self.Pages then
            targetIndex = target
        end
    elseif type(target) == "string" then
        for i, page in ipairs(self.Pages) do
            if page.Name == target or page.Title == target then
                targetIndex = i
                break
            end
        end
    end

    if not targetIndex or targetIndex == self.CurrentPageIndex then
        return
    end

    local oldPage = self.Pages[self.CurrentPageIndex]
    local newPage = self.Pages[targetIndex]

    if oldPage and oldPage.Frame then
        oldPage.Frame.Visible = false
    end
    if newPage and newPage.Frame then
        newPage.Frame.Visible = true
    end

    self.CurrentPageIndex = targetIndex

    -- อัปเดตข้อความ Title ด้านบน
    if self.TitleMain and self.TitleShadow then
        local pageTitle = newPage.Title or newPage.Name or "Dashboard"
        self.TitleMain.Text = pageTitle
        self.TitleShadow.Text = pageTitle
    end

    -- ปิดเมนู Dropdown หากเปิดค้างไว้
    if self.CloseDropdown then
        self.CloseDropdown()
    end
end

-- เลื่อนไปหน้าถัดไป (วนลูปกลับมาหน้าแรกเมื่อถึงหน้าสุดท้าย)
function UIManager:NextPage()
    if not self.Pages or #self.Pages <= 1 then return end
    local nextIdx = (self.CurrentPageIndex % #self.Pages) + 1
    self:SetPage(nextIdx)
end

-- เลื่อนไปหน้าก่อนหน้า (วนลูปไปหน้าสุดท้ายเมื่ออยู่หน้าแรก)
function UIManager:PrevPage()
    if not self.Pages or #self.Pages <= 1 then return end
    local prevIdx = self.CurrentPageIndex - 1
    if prevIdx < 1 then prevIdx = #self.Pages end
    self:SetPage(prevIdx)
end

-- ดึงข้อมูลหน้าปัจจุบัน (index, pageData)
function UIManager:GetActivePage()
    return self.CurrentPageIndex, self.Pages and self.Pages[self.CurrentPageIndex]
end

-- สร้างหน้าใหม่และส่งคืน Frame สำหรับใส่ Widgets เพิ่มเติม
function UIManager:CreatePage(configOrName)
    local pageName, pageTitle
    if type(configOrName) == "table" then
        pageName = configOrName.Name or ("Page_" .. tostring(#self.Pages + 1))
        pageTitle = configOrName.Title or pageName
    else
        pageName = tostring(configOrName or ("Page_" .. tostring(#self.Pages + 1)))
        pageTitle = pageName
    end

    local pageFrame = Instance.new("Frame")
    pageFrame.Name = "Page_" .. pageName
    pageFrame.Size = UDim2.new(1, 0, 1, 0)
    pageFrame.Position = UDim2.new(0, 0, 0, 0)
    pageFrame.BackgroundTransparency = 1
    pageFrame.BorderSizePixel = 0
    pageFrame.Visible = false
    pageFrame.Parent = self.PagesContainer

    local pageEntry = {
        Name = pageName,
        Title = pageTitle,
        Frame = pageFrame
    }
    table.insert(self.Pages, pageEntry)

    -- อัปเดตการแสดงผลของปุ่ม Navigation Arrow
    if self.LeftArrowBtn and self.RightArrowBtn then
        local hasMultiple = #self.Pages > 1
        self.LeftArrowBtn.Visible = hasMultiple
        self.RightArrowBtn.Visible = hasMultiple
    end

    return pageFrame
end

-- กำหนด Callbacks สำหรับการ Hop และ Join Job ID
function UIManager:SetHopCallbacks(callbacks)
    if type(callbacks) == "table" then
        self.HopCallbacks = self.HopCallbacks or {}
        for k, v in pairs(callbacks) do
            self.HopCallbacks[k] = v
        end
    end
end

return UIManager
